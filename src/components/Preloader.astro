---
// Preloader.astro - Ultra-Premium Glassmorphic Preloader for Just Go Market
---

<div id="site-preloader" class="preloader" aria-hidden="false">
  
  <!-- Full Screen Atmospheric Background Glow -->
  <div class="ambient-background"></div>
  
  <!-- Subtle particle dust for depth -->
  <div class="particles">
    {Array.from({ length: 12 }).map((_, i) => (
      <div class={`particle p-${i + 1}`}></div>
    ))}
  </div>

  <div class="preloader-inner mt-spacer">
    <!-- Center Content -->
    <div class="preloader-center">
      
      <!-- Breathtaking Logo Container -->
      <div class="logo-showcase animate-float">
        <div class="glass-container">
          <!-- Subtle inner border for realism -->
          <div class="glass-inner-border"></div>
          
          <!-- The Logo -->
          <img src="/assets/images/logo.png" alt="Just Go Market" class="brand-logo" />
          
          <!-- Inner pulsating glow beneath logo -->
          <div class="logo-inner-glow"></div>
        </div>
      </div>
      
      <!-- Niche Positioning Typography -->
      <div class="typography-section">
        <div class="magnetic-badge reveal-text delay-1">
          <span class="badge-dot"></span>
          Mercado Inteligente 24h
        </div>
        <p class="niche-hook reveal-text delay-2">
          A conveniência a um elevador de distância.
          <strong class="text-green uppercase-hook">Sem filas. Sem fricção.</strong>
        </p>
      </div>
      
      <!-- Progress Bar & Action Text -->
      <div class="progress-section reveal-text delay-3">
        <div class="status-indicator">
          <span class="status-dot"></span>
          <p class="action-text">Iniciando sistema...</p>
        </div>
        
        <div class="progress-wrapper">
          <div class="loading-line"></div>
        </div>
      </div>
      
    </div>
  </div>
</div>

<style>
  /* --- Variables & Base Settings --- */
  :root {
    --preload-bg: #010502; /* Deepest black */
    --preload-green: #a0e261;
    --preload-green-rgb: 160, 226, 97;
  }

  .preloader {
    position: fixed;
    inset: 0;
    background-color: var(--preload-bg);
    z-index: 999999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    /* Strict viewport confinement */
    margin: 0;
    padding: 0;
    overflow: hidden;
    perspective: 1000px;
    border: none;
  }

  /* Transition: Gate Opening Effect */
  .preloader.fade-out {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: scale(1.05) translateY(-2%);
    filter: blur(8px);
    transition: opacity 0.8s ease, visibility 0.8s, transform 1s cubic-bezier(0.8, 0, 0.1, 1), filter 1s ease;
  }

  /* --- Atmospheric Background --- */
  .ambient-background {
    position: absolute;
    inset: 0;
    /* Soft, flawless gradient covering everything */
    background: radial-gradient(circle at center, rgba(var(--preload-green-rgb), 0.12) 0%, rgba(1, 5, 2, 1) 75%);
    z-index: 0;
    animation: pulse-ambient 6s ease-in-out infinite alternate;
  }

  /* --- Floating Particles --- */
  .particles {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .particle {
    position: absolute;
    background: var(--preload-green);
    border-radius: 50%;
    opacity: 0;
    box-shadow: 0 0 12px rgba(var(--preload-green-rgb), 0.6);
    animation: float-particle 6s linear infinite;
  }

  .p-1 { top: 20%; left: 10%; width: 2px; height: 2px; animation-duration: 6s; animation-delay: 0.5s; }
  .p-2 { top: 60%; left: 80%; width: 3px; height: 3px; animation-duration: 4s; animation-delay: 1.2s; }
  .p-3 { top: 40%; left: 50%; width: 2px; height: 2px; animation-duration: 7s; animation-delay: 2.1s; }
  .p-4 { top: 80%; left: 30%; width: 4px; height: 4px; animation-duration: 5s; animation-delay: 0.1s; }
  .p-5 { top: 15%; left: 70%; width: 2px; height: 2px; animation-duration: 8s; animation-delay: 3.4s; }
  .p-6 { top: 50%; left: 20%; width: 3px; height: 3px; animation-duration: 4.5s; animation-delay: 0.8s; }
  .p-7 { top: 90%; left: 60%; width: 2px; height: 2px; animation-duration: 6.5s; animation-delay: 1.9s; }
  .p-8 { top: 30%; left: 90%; width: 1.5px; height: 1.5px; animation-duration: 5.5s; animation-delay: 0.3s; }
  .p-9 { top: 75%; left: 15%; width: 3px; height: 3px; animation-duration: 3.5s; animation-delay: 2.5s; }
  .p-10 { top: 25%; left: 45%; width: 2px; height: 2px; animation-duration: 7.5s; animation-delay: 1.1s; }
  .p-11 { top: 85%; left: 85%; width: 1px; height: 1px; animation-duration: 5s; animation-delay: 1.4s; }
  .p-12 { top: 45%; left: 5%; width: 2.5px; height: 2.5px; animation-duration: 6.2s; animation-delay: 0.6s; }

  /* --- Main Container --- */
  .preloader-inner {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
    padding: 1.5rem;
    box-sizing: border-box;
  }

  .preloader-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3.5rem;
    width: 100%;
    max-width: 600px;
  }

  /* --- Breathtaking Logo Showcase --- */
  .logo-showcase {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: clamp(120px, 35vw, 160px);
    height: clamp(120px, 35vw, 160px);
  }

  .animate-float {
    animation: float-logo 4s ease-in-out infinite;
  }

  .glass-container {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 36px; /* Elegant superellipse look */
    display: flex;
    align-items: center;
    justify-content: center;
    /* High-end glassmorphism */
    background: rgba(var(--preload-green-rgb), 0.03);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(var(--preload-green-rgb), 0.2);
    box-shadow: 
      0 20px 40px rgba(0, 0, 0, 0.6),
      0 0 40px rgba(var(--preload-green-rgb), 0.15), 
      inset 0 0 20px rgba(var(--preload-green-rgb), 0.05);
    overflow: hidden;
  }

  .glass-inner-border {
    position: absolute;
    inset: 4px;
    border-radius: 32px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    pointer-events: none;
    z-index: 2;
  }

  .brand-logo {
    width: 75%;
    height: 75%;
    object-fit: contain;
    z-index: 10;
    filter: drop-shadow(0 0 12px rgba(var(--preload-green-rgb), 0.5));
  }

  .logo-inner-glow {
    position: absolute;
    inset: 0;
    background: rgba(var(--preload-green-rgb), 0.15);
    filter: blur(24px);
    z-index: 1;
    animation: pulse-inner-glow 3s ease-in-out infinite alternate;
  }

  /* --- Typography & Niche Messaging --- */
  .typography-section {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
    position: relative;
    z-index: 30;
  }

  .magnetic-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 20px;
    background: linear-gradient(135deg, rgba(var(--preload-green-rgb), 0.1), rgba(var(--preload-green-rgb), 0.02));
    border: 1px solid rgba(var(--preload-green-rgb), 0.3);
    border-radius: 100px;
    color: var(--preload-green);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5), inset 0 0 10px rgba(var(--preload-green-rgb), 0.1);
    backdrop-filter: blur(10px);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--preload-green);
    border-radius: 50%;
    box-shadow: 0 0 12px var(--preload-green), 0 0 6px #fff;
    animation: blink-dot 1.5s infinite alternate;
  }

  .niche-hook {
    color: rgba(255, 255, 255, 0.85);
    font-size: clamp(0.9rem, 4vw, 1.2rem);
    line-height: 1.5;
    max-width: 450px;
    font-weight: 300;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  .text-green { 
    color: var(--preload-green); 
    text-shadow: 0 0 20px rgba(var(--preload-green-rgb), 0.2);
  }

  .uppercase-hook {
    display: block;
    font-size: clamp(0.8rem, 3.5vw, 1rem);
    letter-spacing: 0.12em;
    margin-top: 10px;
    font-weight: 600;
  }

  /* --- Progress Bar Architecture --- */
  .progress-section {
    width: 100%;
    max-width: 320px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    position: relative;
    z-index: 30;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(0, 0, 0, 0.4);
    padding: 6px 18px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(8px);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--preload-green);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--preload-green);
  }

  .action-text {
    color: rgba(255, 255, 255, 0.95);
    font-size: clamp(0.7rem, 3vw, 0.8rem);
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.05em;
    margin: 0;
    text-transform: uppercase;
    text-align: center;
    width: 100%;
    min-width: 220px;
    transition: opacity 0.3s ease;
  }

  /* Minimalist Infinite Loading Line */
  .progress-wrapper {
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }

  .loading-line {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 30%;
    background: var(--preload-green);
    box-shadow: 0 0 15px 2px rgba(var(--preload-green-rgb), 0.8);
    border-radius: 4px;
    animation: slide-loading 2s ease-in-out infinite;
  }

  /* --- Reveal Animations --- */
  .reveal-text {
    opacity: 0;
    transform: translateY(15px);
    animation: reveal-up 0.8s cubic-bezier(0.2, 1, 0.3, 1) forwards;
  }

  .delay-1 { animation-delay: 0.3s; }
  .delay-2 { animation-delay: 0.5s; }
  .delay-3 { animation-delay: 0.7s; }

  /* --- Keyframes --- */
  @keyframes reveal-up {
    0% { opacity: 0; transform: translateY(20px) scale(0.98); filter: blur(5px); }
    100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
  }

  @keyframes float-logo {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); box-shadow: 0 25px 45px rgba(0,0,0,0.5); }
  }

  @keyframes pulse-ambient {
    0% { opacity: 0.8; transform: scale(0.95); }
    100% { opacity: 1; transform: scale(1.05); }
  }

  @keyframes pulse-inner-glow {
    0%, 100% { opacity: 0.6; transform: scale(0.9); }
    50% { opacity: 1; transform: scale(1.1); }
  }

  @keyframes blink-dot {
    0% { opacity: 1; box-shadow: 0 0 12px var(--preload-green), 0 0 6px #fff; }
    100% { opacity: 0.4; box-shadow: 0 0 4px var(--preload-green); }
  }

  @keyframes float-particle {
    0% { transform: translateY(0) translateX(0); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translateY(-100px) translateX(30px); opacity: 0; }
  }

  @keyframes slide-loading {
    0% { left: -30%; }
    100% { left: 100%; }
  }
</style>

<script>
  // Advanced Condo-focused CTAs
  const loadingPhrases = [
    "Zero custo de implantação para o condomínio...",
    "Valorização imediata do patrimônio...",
    "Segurança 24h com IA e Câmeras conectadas...",
    "Sem mensalidade. Sem dores de cabeça...",
    "Inovação e conforto para os moradores...",
    "Destrancando portas do seu Mercado Just Go..."
  ];

  window.addEventListener('load', () => {
    const preloader = document.getElementById('site-preloader');
    const actionText = preloader?.querySelector('.action-text');
    const statusDot = preloader?.querySelector('.status-dot');
    const loadingLine = preloader?.querySelector('.loading-line');
    
    let phraseIndex = 0;
    const switchPhrase = () => {
      if (actionText && phraseIndex < loadingPhrases.length - 1) {
        phraseIndex++;
        // Fade out
        actionText.style.opacity = '0';
        
        // Change text and Fade in
        setTimeout(() => {
          actionText.textContent = loadingPhrases[phraseIndex];
          actionText.style.opacity = '1';
        }, 300);
      }
    };
    
    // Switch every 800ms
    const textInterval = setInterval(switchPhrase, 800);

    if (preloader) {
      setTimeout(() => {
        clearInterval(textInterval);
        
        if (actionText) {
          actionText.textContent = "ACESSO LIBERADO.";
          actionText.style.color = "var(--preload-green)";
          actionText.style.fontWeight = "700";
          actionText.style.letterSpacing = "0.15em";
        }
        
        if (statusDot) {
          statusDot.style.background = "#fff";
          statusDot.style.boxShadow = "0 0 15px #fff";
        }

        if (loadingLine) {
          // Freeze animation and spread it across the entire bar to signal completion
          (loadingLine as HTMLElement).style.animation = 'none';
          (loadingLine as HTMLElement).style.left = '0';
          (loadingLine as HTMLElement).style.width = '100%';
        }
        
        // Trigger the elegant exit
        setTimeout(() => {
          preloader.classList.add('fade-out');
          document.body.style.overflow = 'auto'; // Re-enable scroll
        }, 600);
      }, 4800); // Gives them enough time to read the value propositions
    }
  });

  // Lock body scroll while active
  document.body.style.overflow = 'hidden';
</script>
