---
// Multi-step Contact Form with WhatsApp integration and tracking
---

<section id="contato" class="section-contact">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <span class="uppercase highlight">Fale Conosco</span>
        <h2>Leve o Mercado Autônomo Just Go para o seu condomínio.</h2>
        <p>Preencha o formulário ao lado e nossa equipe de consultoria retornará em até 24 horas com um estudo de viabilidade personalizado.</p>

        <div class="contact-box">
          <h4>Contato Direto</h4>
          <p>
            (61) 99991-8007<br />
            justgomarket@justgomarket.com.br
          </p>
        </div>
      </div>

      <div class="form-wrapper">
        <form class="form-container" id="contactForm">
          <!-- Step indicator -->
          <div style="display: flex; gap: 8px; margin-bottom: 30px; justify-content: center;">
            <div class="step-dot active" data-step-dot="1" style="width: 40px; height: 4px; border-radius: 2px; background: var(--color-green); transition: all 0.3s;"></div>
            <div class="step-dot" data-step-dot="2" style="width: 40px; height: 4px; border-radius: 2px; background: rgba(255,255,255,0.2); transition: all 0.3s;"></div>
            <div class="step-dot" data-step-dot="3" style="width: 40px; height: 4px; border-radius: 2px; background: rgba(255,255,255,0.2); transition: all 0.3s;"></div>
          </div>

          <!-- Step 1: Profile -->
          <div id="form-step-1" data-form-step="1">
            <p style="color: var(--color-offwhite); text-align: center; font-weight: 600; margin-bottom: 20px;">Qual é o seu perfil?</p>
            <div class="profile-options">
              <input type="radio" name="perfil" id="p-sindico" value="sindico" hidden checked />
              <label for="p-sindico" class="radio-label">Sou Síndico</label>

              <input type="radio" name="perfil" id="p-morador" value="morador" hidden />
              <label for="p-morador" class="radio-label">Sou Morador</label>
            </div>
            <button type="button" class="btn btn-primary btn-block" data-next-step="2">Continuar →</button>
          </div>

          <!-- Step 2: Condo Info -->
          <div id="form-step-2" data-form-step="2" style="display: none;">
            <div id="fields-syndic">
              <div class="form-group">
                <label>Nome do Condomínio</label>
                <input type="text" class="form-control" placeholder="Nome do empreendimento" id="condoName" />
              </div>
              <div class="form-group">
                <label>Qtd de Unidades</label>
                <select class="form-control" id="unitCount">
                  <option>Até 200</option>
                  <option>200 a 500</option>
                  <option>Mais de 500</option>
                </select>
              </div>
              <div class="form-group">
                <label>Região</label>
                <select class="form-control" id="region">
                  <option>Brasília — Asa Norte</option>
                  <option>Brasília — Asa Sul</option>
                  <option>Noroeste</option>
                  <option>Sudoeste</option>
                  <option>Águas Claras</option>
                  <option>Taguatinga</option>
                  <option>Lago Sul / Norte</option>
                  <option>Valparaíso</option>
                  <option>Outra região</option>
                </select>
              </div>
            </div>
            <div id="fields-resident" style="display: none;">
              <div class="form-group">
                <label>Nome do seu Condomínio (indicação)</label>
                <input type="text" class="form-control" placeholder="Onde você mora?" id="referral" />
              </div>
            </div>
            <div style="display: flex; gap: 15px;">
              <button type="button" class="btn btn-outline" data-prev-step="1" style="flex: 1; border-color: rgba(255,255,255,0.2); color: var(--color-offwhite);">← Voltar</button>
              <button type="button" class="btn btn-primary" data-next-step="3" style="flex: 2;">Continuar →</button>
            </div>
          </div>

          <!-- Step 3: Contact Info -->
          <div id="form-step-3" data-form-step="3" style="display: none;">
            <div class="form-group">
              <label>Nome Completo</label>
              <input type="text" class="form-control" placeholder="Seu nome" id="name" required />
            </div>
            <div class="form-group">
              <label>WhatsApp</label>
              <input type="tel" class="form-control" placeholder="(61) 9XXXX-XXXX" id="whatsapp" required pattern="\(?\d{2}\)?\s?\d{4,5}-?\d{4}" />
            </div>
            <div style="display: flex; gap: 15px;">
              <button type="button" class="btn btn-outline" data-prev-step="2" style="flex: 1; border-color: rgba(255,255,255,0.2); color: var(--color-offwhite);">← Voltar</button>
              <button type="submit" class="btn btn-primary btn-glow" style="flex: 2;">Solicitar Visita</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Multi-step form logic
  document.querySelectorAll('[data-next-step]').forEach(btn => {
    btn.addEventListener('click', () => {
      const nextStep = (btn as HTMLElement).getAttribute('data-next-step');
      navigateStep(nextStep!);
    });
  });

  document.querySelectorAll('[data-prev-step]').forEach(btn => {
    btn.addEventListener('click', () => {
      const prevStep = (btn as HTMLElement).getAttribute('data-prev-step');
      navigateStep(prevStep!);
    });
  });

  function navigateStep(step: string) {
    document.querySelectorAll('[data-form-step]').forEach(s => {
      (s as HTMLElement).style.display = 'none';
    });
    const target = document.querySelector(`[data-form-step="${step}"]`) as HTMLElement;
    if (target) target.style.display = 'block';

    // Update dots
    document.querySelectorAll('[data-step-dot]').forEach(dot => {
      const dotStep = (dot as HTMLElement).getAttribute('data-step-dot');
      (dot as HTMLElement).style.background = dotStep && parseInt(dotStep) <= parseInt(step) ? 'var(--color-green)' : 'rgba(255,255,255,0.2)';
    });
  }

  // Profile toggle
  const profileRadios = document.querySelectorAll('input[name="perfil"]');
  profileRadios.forEach(radio => {
    radio.addEventListener('change', () => {
      const val = (radio as HTMLInputElement).value;
      const syndicFields = document.getElementById('fields-syndic');
      const residentFields = document.getElementById('fields-resident');
      if (syndicFields && residentFields) {
        syndicFields.style.display = val === 'sindico' ? 'block' : 'none';
        residentFields.style.display = val === 'morador' ? 'block' : 'none';
      }
    });
  });

  // Form submit → WhatsApp
  const form = document.getElementById('contactForm') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const name = (document.getElementById('name') as HTMLInputElement).value;
      const whatsapp = (document.getElementById('whatsapp') as HTMLInputElement).value;
      const profile = (document.querySelector('input[name="perfil"]:checked') as HTMLInputElement).value;

      let message = `*👋 Novo Contato via Site Just Go Market*\n\n`;
      message += `👤 *Nome:* ${name}\n`;
      message += `📱 *WhatsApp:* ${whatsapp}\n`;
      message += `🏷️ *Perfil:* ${profile === 'sindico' ? 'Síndico' : 'Morador'}\n\n`;

      if (profile === 'sindico') {
        const condoName = (document.getElementById('condoName') as HTMLInputElement).value;
        const unitCount = (document.getElementById('unitCount') as HTMLSelectElement).value;
        const region = (document.getElementById('region') as HTMLSelectElement).value;
        message += `🏢 *Condomínio:* ${condoName}\n`;
        message += `🔢 *Unidades:* ${unitCount}\n`;
        message += `📍 *Região:* ${region}\n`;
      } else {
        const referral = (document.getElementById('referral') as HTMLInputElement).value;
        message += `📍 *Indicação:* ${referral}\n`;
      }

      // Track event
      if (window.dataLayer) {
        window.dataLayer.push({
          event: 'lead_submit',
          lead_profile: profile,
          lead_source: 'contact_form',
        });
      }

      const encodedMessage = encodeURIComponent(message);
      const whatsappUrl = `https://wa.me/5561999918007?text=${encodedMessage}`;

      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (btn) {
        const originalText = btn.innerText;
        btn.innerText = 'Enviando...';
        btn.disabled = true;

        setTimeout(() => {
          window.open(whatsappUrl, '_blank');
          btn.innerText = originalText;
          btn.disabled = false;
        }, 800);
      }
    });
  }
</script>
