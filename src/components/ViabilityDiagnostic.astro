---
// ViabilityDiagnostic — Multi-step Viability Diagnostic (Astro Island)
// Replaces CondominioDiagnostic. No financial logic — consultive tool only.
---

<div class="vd" id="viability-diagnostic">
  <!-- Progress Bar -->
  <div class="vd-progress">
    <div class="vd-progress-bar" id="vd-bar" style="width: 20%;"></div>
    <div class="vd-steps-indicator">
      <span class="vd-step-dot active" data-step="1">1</span>
      <span class="vd-step-dot" data-step="2">2</span>
      <span class="vd-step-dot" data-step="3">3</span>
      <span class="vd-step-dot" data-step="4">4</span>
      <span class="vd-step-dot" data-step="5">5</span>
    </div>
  </div>

  <!-- STEP 1: Introdução -->
  <div class="vd-screen active" data-screen="1">
    <div class="vd-intro-icon">📊</div>
    <h3 class="vd-title">Diagnóstico Inteligente de Viabilidade</h3>
    <p class="vd-subtitle">Descubra se o seu condomínio tem o perfil ideal para receber um mini mercado autônomo.<br>A avaliação leva menos de 2 minutos.</p>
    <div class="vd-intro-features">
      <div class="vd-intro-feat"><span>🏢</span><span>Análise Estrutural</span></div>
      <div class="vd-intro-feat"><span>👥</span><span>Perfil dos Moradores</span></div>
      <div class="vd-intro-feat"><span>📍</span><span>Ambiente Externo</span></div>
      <div class="vd-intro-feat"><span>✅</span><span>Resultado Imediato</span></div>
    </div>
    <button class="btn btn-primary btn-glow vd-btn-start" id="vd-start">Iniciar Diagnóstico</button>
  </div>

  <!-- STEP 2: Dados Estruturais -->
  <div class="vd-screen" data-screen="2">
    <p class="vd-step-label">Etapa 1 de 3 — Dados Estruturais</p>
    <h3 class="vd-title">Sobre o Condomínio</h3>

    <div class="vd-field">
      <label class="vd-label">Quantas unidades residenciais?</label>
      <div class="vd-card-options" id="vd-units">
        <button class="vd-card-opt" data-value="small">Até 40</button>
        <button class="vd-card-opt" data-value="medium">40 a 120</button>
        <button class="vd-card-opt active" data-value="large">Mais de 120</button>
      </div>
    </div>

    <div class="vd-field">
      <label class="vd-label">Possui portaria 24 horas?</label>
      <div class="vd-toggle-group" id="vd-portaria">
        <button class="vd-toggle active" data-value="true">Sim</button>
        <button class="vd-toggle" data-value="false">Não</button>
      </div>
    </div>

    <div class="vd-field">
      <label class="vd-label">Padrão do condomínio</label>
      <div class="vd-card-options" id="vd-padrao">
        <button class="vd-card-opt" data-value="alto">Alto Padrão</button>
        <button class="vd-card-opt active" data-value="medio">Médio Padrão</button>
        <button class="vd-card-opt" data-value="outro">Padrão</button>
      </div>
    </div>

    <div class="vd-nav">
      <button class="btn btn-outline vd-btn-back" data-to="1">Voltar</button>
      <button class="btn btn-primary vd-btn-next" data-to="3">Próximo</button>
    </div>
  </div>

  <!-- STEP 3: Perfil dos Moradores -->
  <div class="vd-screen" data-screen="3">
    <p class="vd-step-label">Etapa 2 de 3 — Perfil dos Moradores</p>
    <h3 class="vd-title">Quem São os Moradores</h3>

    <div class="vd-field">
      <label class="vd-label">Nível de uso de apps de delivery / compras online</label>
      <div class="vd-card-options" id="vd-apps">
        <button class="vd-card-opt active" data-value="alto">Alto</button>
        <button class="vd-card-opt" data-value="medio">Moderado</button>
        <button class="vd-card-opt" data-value="baixo">Baixo</button>
      </div>
    </div>

    <div class="vd-field">
      <label class="vd-label">Perfil predominante</label>
      <div class="vd-card-options" id="vd-perfil">
        <button class="vd-card-opt" data-value="familias">Famílias</button>
        <button class="vd-card-opt active" data-value="jovens">Jovens / Casais</button>
        <button class="vd-card-opt" data-value="idosos">Público Maduro</button>
        <button class="vd-card-opt" data-value="misto">Misto</button>
      </div>
    </div>

    <div class="vd-nav">
      <button class="btn btn-outline vd-btn-back" data-to="2">Voltar</button>
      <button class="btn btn-primary vd-btn-next" data-to="4">Próximo</button>
    </div>
  </div>

  <!-- STEP 4: Ambiente Externo -->
  <div class="vd-screen" data-screen="4">
    <p class="vd-step-label">Etapa 3 de 3 — Ambiente Externo</p>
    <h3 class="vd-title">Contexto ao Redor</h3>

    <div class="vd-field">
      <label class="vd-label">Distância até o mercado/conveniência mais próximo</label>
      <div class="vd-card-options" id="vd-distancia">
        <button class="vd-card-opt active" data-value="longe">Mais de 800m</button>
        <button class="vd-card-opt" data-value="medio">300 a 800m</button>
        <button class="vd-card-opt" data-value="perto">Menos de 300m</button>
      </div>
    </div>

    <div class="vd-field">
      <label class="vd-label">Fluxo de moradores no período noturno</label>
      <div class="vd-card-options" id="vd-fluxo">
        <button class="vd-card-opt active" data-value="alto">Alto</button>
        <button class="vd-card-opt" data-value="medio">Moderado</button>
        <button class="vd-card-opt" data-value="baixo">Baixo</button>
      </div>
    </div>

    <div class="vd-nav">
      <button class="btn btn-outline vd-btn-back" data-to="3">Voltar</button>
      <button class="btn btn-primary vd-btn-next vd-btn-result" data-to="5">Ver Resultado</button>
    </div>
  </div>

  <!-- STEP 5: Resultado -->
  <div class="vd-screen" data-screen="5">
    <p class="vd-step-label">Resultado do Diagnóstico</p>

    <div class="vd-gauge-container">
      <div class="vd-gauge" id="vd-gauge">
        <svg viewBox="0 0 200 200" class="vd-gauge-svg">
          <circle cx="100" cy="100" r="85" class="vd-gauge-bg"/>
          <circle cx="100" cy="100" r="85" class="vd-gauge-fill" id="vd-gauge-fill"
            stroke-dasharray="534" stroke-dashoffset="534"/>
        </svg>
        <div class="vd-gauge-value">
          <span class="vd-gauge-number" id="vd-score-number">0</span>
          <span class="vd-gauge-label">de 100</span>
        </div>
      </div>
    </div>

    <div class="vd-classification" id="vd-classification"></div>

    <div class="vd-benefits" id="vd-benefits">
      <h4>Benefícios previstos para o condomínio</h4>
      <ul>
        <li id="vd-ben-1"><span class="vd-ben-icon">🛒</span><span><strong>Conveniência 24h</strong> — Acesso imediato a itens essenciais, sem sair do condomínio, a qualquer hora do dia ou da noite.</span></li>
        <li id="vd-ben-2"><span class="vd-ben-icon">📈</span><span><strong>Valorização do Condomínio</strong> — Infraestrutura moderna que aumenta a percepção de valor do empreendimento.</span></li>
        <li id="vd-ben-3"><span class="vd-ben-icon">🚗</span><span><strong>Redução de Deslocamentos</strong> — Menos viagens ao supermercado, mais tempo livre e menos trânsito.</span></li>
      </ul>
    </div>

    <div class="vd-recommendation" id="vd-recommendation"></div>

    <div class="vd-result-actions">
      <a href="/#contato" class="btn btn-primary btn-glow">Solicitar Visita Técnica Gratuita</a>
      <button class="btn btn-outline vd-btn-restart" id="vd-restart">Refazer Diagnóstico</button>
    </div>
  </div>
</div>

<script>
  (function() {
    const root = document.getElementById('viability-diagnostic');
    if (!root) return;

    const screens = root.querySelectorAll('.vd-screen');
    const dots = root.querySelectorAll('.vd-step-dot');
    const bar = document.getElementById('vd-bar');
    let currentStep = 1;

    // --- Helpers ---
    function getSelected(groupId: string): string {
      const group = document.getElementById(groupId);
      if (!group) return '';
      const active = group.querySelector('.active') as HTMLElement | null;
      return active?.dataset.value || '';
    }

    function goTo(step: number) {
      screens.forEach(s => {
        s.classList.remove('active');
        if (Number((s as HTMLElement).dataset.screen) === step) s.classList.add('active');
      });
      dots.forEach(d => {
        const ds = Number((d as HTMLElement).dataset.step);
        d.classList.toggle('active', ds <= step);
        d.classList.toggle('completed', ds < step);
      });
      if (bar) bar.style.width = `${(step / 5) * 100}%`;
      currentStep = step;
      if (root) {
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // --- Card / Toggle selection ---
    root.querySelectorAll('.vd-card-options, .vd-toggle-group').forEach(group => {
      group.querySelectorAll('button').forEach(btn => {
        btn.addEventListener('click', () => {
          group.querySelectorAll('button').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });
    });

    // --- Navigation ---
    root.querySelectorAll('.vd-btn-next, .vd-btn-back').forEach(btn => {
      btn.addEventListener('click', () => {
        const to = Number((btn as HTMLElement).dataset.to);
        if (to === 5) {
          calculateAndShow();
        }
        goTo(to);
      });
    });

    // Start button
    const startBtn = document.getElementById('vd-start');
    if (startBtn) {
      startBtn.addEventListener('click', () => {
        goTo(2);
        // Analytics: diagnostic_started
        if ((window as any).dataLayer) {
          (window as any).dataLayer.push({ event: 'diagnostic_started' });
        }
      });
    }

    // Restart
    const restartBtn = document.getElementById('vd-restart');
    if (restartBtn) {
      restartBtn.addEventListener('click', () => goTo(1));
    }

    // --- Score Calculation ---
    function calculateAndShow() {
      const units = getSelected('vd-units');
      const portaria = getSelected('vd-portaria');
      const padrao = getSelected('vd-padrao');
      const apps = getSelected('vd-apps');
      const distancia = getSelected('vd-distancia');
      const fluxo = getSelected('vd-fluxo');

      let raw = 0;

      // Unidades
      if (units === 'small') raw += 10;
      else if (units === 'medium') raw += 20;
      else if (units === 'large') raw += 30;

      // Portaria 24h
      if (portaria === 'true') raw += 15;

      // Padrão
      if (padrao === 'alto') raw += 20;
      else if (padrao === 'medio') raw += 10;

      // Distância mercado
      if (distancia === 'longe') raw += 15;
      else if (distancia === 'medio') raw += 8;

      // Fluxo noturno
      if (fluxo === 'alto') raw += 15;

      // Uso apps
      if (apps === 'alto') raw += 10;

      // Normalize to 0–100
      const MAX_RAW = 105;
      const score = Math.min(100, Math.round((raw / MAX_RAW) * 100));

      // Classification
      let classification: string, classColor: string, emoji: string, recommendation: string;

      if (score >= 80) {
        classification = 'Viabilidade Excelente';
        classColor = '#a0e261';
        emoji = '🟢';
        recommendation = 'O seu condomínio apresenta um perfil excepcional para receber um mini mercado autônomo. A combinação de estrutura, perfil de moradores e localização indica altíssima aderência. Recomendamos solicitar uma visita técnica para definir o melhor espaço e modelo.';
      } else if (score >= 60) {
        classification = 'Viabilidade Alta';
        classColor = '#a0e261';
        emoji = '🟢';
        recommendation = 'Seu condomínio possui ótimo potencial. A maioria dos indicadores aponta para uma excelente aderência dos moradores ao conceito de conveniência autônoma. Uma avaliação presencial pode confirmar os detalhes.';
      } else if (score >= 40) {
        classification = 'Viabilidade Moderada';
        classColor = '#f5c542';
        emoji = '🟡';
        recommendation = 'Seu condomínio apresenta potencial, com alguns pontos que merecem avaliação mais detalhada. Recomendamos uma consultoria gratuita para entender melhor as particularidades do seu condomínio.';
      } else {
        classification = 'Avaliação Necessária';
        classColor = '#f5a442';
        emoji = '🟠';
        recommendation = 'Cada condomínio é único. Mesmo com pontuação inicial moderada, fatores locais podem revelar grande potencial. Agende uma visita sem compromisso para uma análise personalizada.';
      }

      // Render score gauge animation
      const gaugeFill = document.getElementById('vd-gauge-fill');
      const scoreNumber = document.getElementById('vd-score-number');
      const classificationEl = document.getElementById('vd-classification');
      const recommendationEl = document.getElementById('vd-recommendation');

      if (gaugeFill) {
        const circumference = 534;
        const offset = circumference - (score / 100) * circumference;
        setTimeout(() => {
          gaugeFill.style.strokeDashoffset = String(offset);
          gaugeFill.style.stroke = classColor;
        }, 300);
      }

      // Animate number
      if (scoreNumber) {
        let current = 0;
        const step = Math.max(1, Math.floor(score / 40));
        const timer = setInterval(() => {
          current += step;
          if (current >= score) {
            current = score;
            clearInterval(timer);
          }
          scoreNumber.textContent = String(current);
        }, 30);
      }

      if (classificationEl) {
        classificationEl.innerHTML = `<span class="vd-class-badge" style="background: ${classColor}; color: #010502;">${emoji} ${classification}</span>`;
      }

      if (recommendationEl) {
        recommendationEl.innerHTML = `
          <h4>Recomendação</h4>
          <p>${recommendation}</p>
        `;
      }

      // Analytics: diagnostic_completed + diagnostic_score
      if ((window as any).dataLayer) {
        (window as any).dataLayer.push({
          event: 'diagnostic_completed',
          diagnostic_score: score,
          diagnostic_classification: classification,
        });
        (window as any).dataLayer.push({
          event: 'diagnostic_score',
          score: score,
          classification: classification,
        });
      }
    }
  })();
</script>
