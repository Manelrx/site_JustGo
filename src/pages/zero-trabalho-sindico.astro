---
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import WhatsAppFloat from '@components/WhatsAppFloat.astro';
import CTASticky from '@components/CTASticky.astro';
import { breadcrumbSchema } from '@lib/schema';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: 'https://www.justgomarket.com.br/' },
    { name: 'Zero Trabalho para o Síndico', url: 'https://www.justgomarket.com.br/zero-trabalho-sindico/' },
  ]),
];

const checklistItems = [
  { icon: '📦', title: 'Não administra estoque', desc: 'A Just Go Market controla todo o inventário: pedidos, reposição, validade, perdas. O síndico não precisa contar produtos, fazer pedidos ou se preocupar com vencimento.' },
  { icon: '💳', title: 'Não cobra moradores', desc: 'O pagamento é feito diretamente pelo morador no totem — cartão de crédito ou débito. Não passa pelo caixa do condomínio. Não gera boleto. Não gera inadimplência.' },
  { icon: '🧾', title: 'Não controla pagamentos', desc: 'Toda a gestão financeira das vendas é da Just Go Market. Nenhum valor transita pela conta do condomínio. O síndico não emite notas, não faz conciliação, não declara nada.' },
  { icon: '⚠️', title: 'Não assume prejuízo', desc: 'Em caso de furto, dano ou problema técnico, a responsabilidade é integralmente da Just Go Market. Temos seguro próprio. O condomínio está 100% protegido de qualquer prejuízo.' },
  { icon: '🔧', title: 'Não faz manutenção', desc: 'Geladeira quebrou? Totem com defeito? Câmera parou? Nossa equipe resolve. O síndico não precisa chamar técnico, não precisa orçar, não precisa acompanhar reparo.' },
  { icon: '👥', title: 'Não contrata funcionários', desc: 'Zero vínculo trabalhista para o condomínio. Nossa equipe de reposição e limpeza é contratada pela Just Go Market. Sem CLT, sem encargos, sem riscos.' },
  { icon: '⚡', title: 'Não paga energia extra', desc: 'Instalamos medidor individual. O consumo de energia da loja é reembolsado mensalmente pela Just Go Market ao condomínio. A taxa condominial não aumenta.' },
  { icon: '📋', title: 'Não gerencia reclamações', desc: 'Moradores com dúvidas ou problemas entram em contato direto com a Just Go Market via WhatsApp. O canal é exclusivo e atende em tempo real. O síndico não é intermediário.' },
];
---

<BaseLayout
  title="Zero Trabalho para o Síndico — Mercado Autônomo sem Gestão"
  description="O mercado autônomo Just Go Market funciona sem gerar trabalho para o síndico. Sem estoque, sem cobrança, sem manutenção, sem funcionários, sem risco. Entenda como."
  schemas={schemas}
>
  <Header currentPath="/zero-trabalho-sindico" />

  <main>
    <section class="inner-hero">
      <div class="container">
        <span class="uppercase highlight" style="display: block; margin-bottom: 20px;">Para Síndicos</span>
        <h1>Zero Trabalho para o Síndico: O Condomínio Evolui Sem Gerar Gestão</h1>
        <p>O mercado autônomo Just Go Market é uma amenidade que se instala e opera sozinha. O síndico aprova — e a gente cuida de todo o resto.</p>
      </div>
    </section>

    <section class="content-section light-section">
      <div class="container">
        <div class="content-wrapper">
          <h2>O Que o Síndico <span class="highlight-green">NÃO</span> Precisa Fazer</h2>
          <p>A principal dúvida de todo síndico é: <em>"Vai dar trabalho para mim?"</em></p>
          <p>A resposta é não. E não é uma promessa vaga — é o modelo de negócio. A Just Go Market foi desenhada para funcionar de forma autônoma, sem demandar nenhum esforço operacional da administração do condomínio.</p>
          <p>Veja item por item o que o síndico <strong>não precisa fazer</strong>:</p>

          <div style="display: grid; gap: 20px; margin: 40px 0;">
            {checklistItems.map(item => (
              <div class="bento-card" style="flex-direction: row; align-items: flex-start; gap: 20px; padding: 30px;">
                <div style="font-size: 2rem; flex-shrink: 0; line-height: 1;">{item.icon}</div>
                <div>
                  <h3 style="font-size: 1.2rem; margin-bottom: 8px;">{item.title}</h3>
                  <p style="margin-bottom: 0; font-size: 0.95rem;">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <h2>O Que o Síndico Faz (Uma Única Vez)</h2>
          <div class="bento-card" style="border-color: var(--color-green); margin: 30px 0;">
            <h3 style="color: var(--color-green);">Apenas 3 ações — todas antes da instalação:</h3>
            <ol style="list-style: decimal; padding-left: 20px; margin-top: 15px;">
              <li style="padding: 10px 0; font-size: 1rem;"><strong>Receber a visita técnica</strong> — nossa equipe vai ao condomínio avaliar o espaço</li>
              <li style="padding: 10px 0; font-size: 1rem;"><strong>Apresentar na assembleia</strong> — com material 100% preparado por nós</li>
              <li style="padding: 10px 0; font-size: 1rem;"><strong>Assinar o contrato</strong> — após aprovação dos moradores</li>
            </ol>
            <p style="margin-top: 15px; margin-bottom: 0; font-weight: 600;">Depois disso: <span style="color: var(--color-green);">zero envolvimento operacional</span>.</p>
          </div>

          <h2>Por Que Isso é Possível?</h2>
          <p>A Just Go Market não é uma franquia, uma revenda ou uma parceria operacional. Somos uma empresa de tecnologia e varejo que <strong>investe, instala e opera o mercado completo</strong>. O condomínio é nosso parceiro — não nosso franqueado.</p>
          <p>Isso significa que toda a complexidade operacional (logística, estoque, manutenção, segurança, suporte) fica exclusivamente do nosso lado. O condomínio colhe os benefícios sem carregar nenhuma das responsabilidades.</p>

          <div class="text-center" style="margin-top: 60px;">
            <h2>Modernize Seu Condomínio — Sem Trabalho Extra</h2>
            <p style="max-width: 600px; margin: 0 auto 30px;">Converse com nossa equipe e descubra como levar uma amenidade moderna para o seu condomínio sem adicionar uma única tarefa à sua rotina de síndico.</p>
            <a href="/#contato" class="btn btn-primary btn-glow">Falar com a Equipe</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloat />
  <CTASticky />
</BaseLayout>
