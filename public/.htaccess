<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Forçar HTTPS e remover WWW (Non-WWW)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.justgomarket\.com\.br$ [NC]
    RewriteRule ^(.*)$ https://justgomarket.com.br/$1 [L,R=301]

    # 2. Adicionar barra final (Trailing Slash) em diretórios
    # Garante que /sobre vira /sobre/ (comportamento nativo do cPanel)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} !(.*)/$
    RewriteRule ^(.*)$ https://justgomarket.com.br/$1/ [L,R=301]

    # 3. Esconder o index.html gerado pelo Astro
    # Se o usuário acessar https://justgomarket.com.br/sobre/index.html, limpe para /sobre/
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*index\.html\ HTTP/
    RewriteRule ^(([^/]+/)*)index\.html$ https://justgomarket.com.br/$1 [L,R=301]
    
    # 4. Esconder final .html (se sobrou algum link quebrado)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP
    RewriteRule ^([^.]+)\.html$ https://justgomarket.com.br/$1/ [L,R=301]

</IfModule>
