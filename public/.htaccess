<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectoryIndex index.html

    # 1. Forçar HTTPS e remover WWW (Non-WWW)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.justgomarket\.com\.br$ [NC]
    RewriteRule ^(.*)$ https://justgomarket.com.br/$1 [L,R=301]

    # 2. Esconder o index.html principal e das subpastas
    RewriteCond %{THE_REQUEST} ^[A-Z]{3}\ /index\.html\ HTTP/ [NC]
    RewriteRule ^index\.html$ https://justgomarket.com.br/ [R=301,L]

    RewriteCond %{THE_REQUEST} ^[A-Z]{3}\ /(.+)/index\.html\ HTTP/ [NC]
    RewriteRule ^(.+)/index\.html$ https://justgomarket.com.br/$1/ [R=301,L]

    # 3. Remover a barra final de URLs que não são diretórios para limpar a URL (ex: /sobre/ para /sobre)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ https://justgomarket.com.br/$1 [L,R=301]

    # 4. Esconder a extensão .html digitada diretamente na URL
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP [NC]
    RewriteRule ^(%1)\.html$ https://justgomarket.com.br/$1 [R=301,L]

    # 5. Mapear internamente as URLs limpas para seus respectivos arquivos .html gerados pelo Astro
    # Se a URL não for um arquivo nem um diretório, tenta arquivo .html
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # 5.1 Correção para pastas reais criadas pelo Astro que conflitavam com arquivos .html (ex: /blog e blog.html)
    # Se bater em um diretório real e existir o arquivo .html correspondente, força o arquivo .html
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)/?$ $1.html [L]

    # 6. Redirecionamentos de Páginas Antigas (Legado)
    RewriteRule ^calculadora-roi/?$ https://justgomarket.com.br/diagnostico-condominio [R=301,L]
    RewriteRule ^cases/?$ https://justgomarket.com.br/como-funciona-na-pratica [R=301,L]

</IfModule>
