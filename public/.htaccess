<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -MultiViews -Indexes

    # 1. Forçar HTTPS e remover WWW (Non-WWW)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.justgomarket\.com\.br$ [NC]
    RewriteRule ^(.*)$ https://justgomarket.com.br/$1 [L,R=301]

    # 2. Remover barras finais (Trailing Slashes) da URL visível
    # Não remove se for a raiz do site.
    RewriteCond %{REQUEST_URI} ^/(.+)/$
    RewriteRule ^(.*)/$ https://justgomarket.com.br/$1 [L,R=301]

    # 3. Remover extensões .html ou /index.html da URL visível
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP [OR]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*index\.html\ HTTP/
    RewriteRule ^([^.]+)(\.html|/index\.html)$ https://justgomarket.com.br/$1 [L,R=301]

    # 4. Adicionar a extensão .html internamente (sem mudar a URL no navegador)
    # IMPORTANTE: A condição de arquivo html deve vir ANTES de checar o diretório
    # Isso resolve o erro 403 Forbidden do /blog (porque existe o blog.html E a pasta /blog)
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*)$ $1.html [L]

</IfModule>
