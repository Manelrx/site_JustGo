<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Forçar HTTPS e remover WWW (Non-WWW)
    # Se a conexão não for HTTPS OU o domínio iniciar com www
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.justgomarket\.com\.br$ [NC]
    # Redireciona tudo (301) para a versão limpa: https://justgomarket.com.br/...
    RewriteRule ^(.*)$ https://justgomarket.com.br/$1 [L,R=301]

    # 2. Remover barras finais (Trailing Slashes)
    # Se a requisição não for de um diretório válido, retira a barra do final
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ https://justgomarket.com.br/$1 [L,R=301]

    # 3. Remover a extensão .html visível da URL (Redirecionamento 301)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.html\ HTTP
    RewriteRule ^([^.]+)\.html$ https://justgomarket.com.br/$1 [L,R=301]

    # 4. Remover /index.html visível da URL (Redirecionamento 301)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*index\.html\ HTTP/
    RewriteRule ^(([^/]+/)*)index\.html$ https://justgomarket.com.br/$1 [L,R=301]

    # 5. Adicionar a extensão .html internamente (sem mudar a URL no navegador)
    # Pega qualquer requisição, verifica se o arquivo correspondente .html existe, e serve ele.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*)$ $1.html [L]
    
</IfModule>
