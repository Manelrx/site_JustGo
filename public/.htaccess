<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Forçar HTTPS e remover WWW (Non-WWW)
    # Se a conexão não for HTTPS OU o domínio iniciar com www
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.justgomarket\.com\.br$ [NC]
    # Redireciona tudo (301) para a versão limpa: https://justgomarket.com.br/...
    RewriteRule ^(.*)$ https://justgomarket.com.br/$1 [L,R=301]

    # 2. Direcionamento Interno Silencioso do Apache (Roteamento estático limpo)
    # Se a URL não apontar para um diretório real
    RewriteCond %{REQUEST_FILENAME} !-d
    # E não apontar para um arquivo real (como imagem, css, etc)
    RewriteCond %{REQUEST_FILENAME} !-f
    # E existir um arquivo .html com o mesmo nome
    RewriteCond %{REQUEST_FILENAME}.html -f
    # Faça o Apache servir o arquivo .html silenciosamente
    RewriteRule ^(.*)$ $1.html [L]

    # 3. Evitar acesso direto aos arquivos .html pelo navegador
    # (Apenas redireciona se a requisição original vinda do navegador conteve o .html)
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(.+)\.html$ https://justgomarket.com.br/$1 [R=301,L]
    
    # 4. Remover o /index.html do final das URLs (Redirecionamento 301)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+/)*index\.html\ HTTP/
    RewriteRule ^(([^/]+/)*)index\.html$ https://justgomarket.com.br/$1 [L,R=301]
    
</IfModule>
